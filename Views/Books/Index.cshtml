@model IEnumerable<Book>
@{ ViewData["Title"] = "書籍列表"; }

<h2>書籍列表</h2>

<div class="d-flex justify-content-between mb-3">
    <a class="btn btn-success" asp-action="Create">＋ 新增書籍</a>
    <form method="get" class="d-flex gap-2">
        <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="搜尋書名或作者" />
        <button class="btn btn-primary text-nowrap">查詢</button>
    </form>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m.Title)</th>
            <th>@Html.DisplayNameFor(m => m.Author)</th>
            <th>@Html.DisplayNameFor(m => m.Category)</th>
            <th>@Html.DisplayNameFor(m => m.Price)</th>
            <th>@Html.DisplayNameFor(m => m.Stock)</th>
            <th>@Html.DisplayNameFor(m => m.PublishDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.Title</td>
            <td>@b.Author</td>
            <td>@b.Category</td>
            <td>@b.Price.ToString("N0")</td>
            <td>@b.Stock</td>
            <td>@b.PublishDate.ToString("yyyy-MM-dd")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.Id">明細</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">編輯</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.Id">刪除</a>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">查無資料。</p>
}

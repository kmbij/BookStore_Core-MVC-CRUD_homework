@model Book
@{ ViewData["Title"] = "書籍明細"; }
<h2>書籍明細</h2>
<dl class="row col-md-8">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt><dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Author)</dt><dd class="col-sm-9">@Model.Author</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Category)</dt><dd class="col-sm-9">@Model.Category</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Price)</dt><dd class="col-sm-9">@Model.Price.ToString("N0")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Stock)</dt><dd class="col-sm-9">@Model.Stock</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PublishDate)</dt><dd class="col-sm-9">@Model.PublishDate.ToString("yyyy-MM-dd")</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">編輯</a>
<a class="btn btn-secondary" asp-action="Index">返回</a>
